# Los secretos de Radio Marea. Los leen la web (PHP, en cada petición) y la API (Python, al arrancar).
# Este fichero NO está en la carpeta de la web y NO va a Git (mira .gitignore).
# Formato: CLAVE=valor, sin espacios alrededor del = y sin comillas.

# 👀 La contraseña del estudio (para entrar en /api/estudio). Ya está puesta.
LOCUTOR_CLAVE=sintonia-de-medianoche

# ✍️ B2 · La llave que firma las sesiones de la API: larga y al azar (UD5, apartado 7.3).
SECRET_KEY=

# La base de datos (bloque C)
DB_HOST=db
DB_NAME=radio
# ✍️ C2 · El usuario que creas en el C1 y su contraseña.
DB_USER=
DB_PASS=

# 👀 El usuario de las copias de seguridad (C4): el del ejemplo de sql/usuarios.sql, que solo lee.
COPIAS_USER=radio_copias
COPIAS_PASS=copia-de-la-marea-2026
