# Variables de entorno de la app. Se leen AL ARRANCAR: si cambias algo, ./bateria.sh recargar
# ✍️ 4.3 La llave que firma las cookies de sesión. La de fábrica no vale: 32 caracteres o más, al azar.
#        Para generarla: ./bateria.sh llave
SECRET_KEY=cambiame
# ✍️ 5.2 Modo depuración (1 = sí). Este es el servidor de producción del polideportivo.
FLASK_DEBUG=1
