# Batería UD4 (PHP-FPM) — Nginx, IAW ASIR 2.º (la misma imagen que el laboratorio de clase)
# Debian 13 como en la UD3: trae sites-available/sites-enabled y snippets/ como en un servidor real.
# Nginx NO ejecuta PHP: se lo pasa por FastCGI al contenedor «php» (php:9000).
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends nginx curl ca-certificates procps nano \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default
EXPOSE 80 443
